flowchart TD
    AcceptRequest["AcceptRequest"]
    CheckLimit["CheckLimit"]
    Approve["Approve"]
    Review["Review"]
    SendResponse["SendResponse"]
    ClosedLoopA["ClosedLoopA"]
    ClosedLoopB["ClosedLoopB"]
    AcceptRequest --> CheckLimit
    CheckLimit -->|amount <= limit| Approve
